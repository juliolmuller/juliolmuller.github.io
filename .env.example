# Public origin of the site, without trailing slash. Used for canonical URLs,
# Open Graph, the sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content adapter: "sanity" or "fixtures". When empty, "sanity" is used if
# SANITY_PROJECT_ID and SANITY_DATASET are set, otherwise "fixtures".
CONTENT_SOURCE=

# --- Sanity (server-only; see docs/SANITY.md) -------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=
# Pinned API version (YYYY-MM-DD).
SANITY_API_VERSION=2026-10-01
# Viewer token for reads, Editor token for admin writes.
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
# Shared secret for the optional /api/revalidate webhook.
SANITY_WEBHOOK_SECRET=

# --- Admin (server-only; see docs/ADMIN.md) ---------------------------------
# Plaintext password (16+ characters in production) or, preferably, the scrypt
# hash printed by `bun run admin:hash`. The hash wins when both are set.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Rotating it signs
# out every session.
SESSION_SECRET=

# --- Optional ----------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
