{
  "name": "juliolmuller.com",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "bun run --bun next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "bun audit --audit-level=high --ignore=GHSA-vfj7-8cjw-p6xm",
    "i18n:check": "bun --conditions=react-server scripts/i18n-check.ts",
    "icons:audit": "bun --conditions=react-server scripts/icons-audit.ts",
    "check:seo": "bun --conditions=react-server scripts/check-seo.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "lhci": "bun x @lhci/cli@0.15.1 autorun",
    "content:smoke": "bun --conditions=react-server scripts/content-smoke.ts",
    "sanity:schema": "bun scripts/sanity-schema.ts",
    "fixtures:generate": "bun scripts/generate-fixtures.ts && eslint --fix src/lib/content/fixtures/assets.generated.ts",
    "sanity:seed": "bun --conditions=react-server scripts/seed-sanity.ts",
    "admin:hash": "bun --conditions=react-server scripts/admin-hash.ts",
    "update": "bun update --latest && bun add -d eslint@^10 typescript@~6.0",
    "prepare": "husky",
    "admin:smoke": "bun --conditions=react-server scripts/admin-smoke.ts",
    "commit": "commit",
    "release": "semantic-release"
  },
  "dependencies": {
    "@iconify-json/devicon": "^1.2.77",
    "@iconify-json/devicon-plain": "^1.2.68",
    "@sanity/client": "^8.14.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10",
    "eslint-config-any": "^3.0.0-beta.3",
    "groq-js": "^2.0.1",
    "html-validate": "^11.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "schema-dts": "^2.1.0",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.3",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0 <1.5.0",
    "node": ">=24.11.0 <25"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --max-warnings=0 --fix"
    ]
  },
  "trustedDependencies": []
}
